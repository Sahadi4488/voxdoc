# Copy to backend/.env (git-ignored) and fill in. Every setting in app/config.py
# can be set here or as an environment variable, with the VOXDOC_ prefix.

# Groq API key from https://console.groq.com/keys (starts with gsk_).
# Leave empty to run without AI features: reading and audio still work.
VOXDOC_GROQ_API_KEY=

# Free-plan models (Llama is Enterprise-only now). Limits are per model.
VOXDOC_GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
VOXDOC_GROQ_QA_MODEL=openai/gpt-oss-120b

# Optional
# VOXDOC_DATA_DIR=data
# VOXDOC_MAX_UPLOAD_MB=20
# VOXDOC_WARM_TTS=false
# VOXDOC_WARM_EMBEDDER=false
